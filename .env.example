# BluegridOCR root environment example.
# Copy to .env only for local/prod deployment and replace placeholders outside git.

ENVIRONMENT=production
APP_TIMEZONE=America/Santiago

# Ports
BACKEND_PORT=8000
FRONTEND_PORT=3000

# Backend runtime
HOST=0.0.0.0
PORT=8000
HTTPS_ENABLED=false
SSL_CERTFILE=
SSL_KEYFILE=

# External services - never commit real values
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require
SUPABASE_KEY=replace-with-runtime-secret
ANTHROPIC_API_KEY=replace-with-runtime-secret
ANTHROPIC_MODEL=claude-sonnet-5
ANTHROPIC_OCR_AUDIT_MODEL=claude-sonnet-5
OCR_MODE=segmented

# Auth
JWT_SECRET_KEY=replace-with-runtime-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480
TRUST_PROXY_HEADERS=false

# CORS
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001,http://127.0.0.1:3001

# Frontend runtime
API_BASE_URL=http://localhost:8000
VITE_API_BASE_URL=http://localhost:8000
VITE_ENABLE_MOCK_DATA=false

# Optional local tunneling
NGROK_TOKEN=
